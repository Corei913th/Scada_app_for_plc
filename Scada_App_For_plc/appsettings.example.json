{
  // MODÈLE de configuration, suivi par git. Copie ce fichier en « appsettings.json » (ignoré par git)
  // puis mets ton vrai mot de passe PostgreSQL à la place de CHANGE_ME.
  // Les commentaires // sont acceptés (AppSettings.Load les ignore).
  "Plc": {
    // ===== TROIS CONFIGURATIONS POSSIBLES : garde un seul bloc actif, les autres en commentaire =====
    //
    // 1) Simulateur d'ISPSoft (COMMGR « DVP Simulator », celui qui exécute ton vrai Ladder)  <-- ACTIF
    "Ip": "127.0.0.1",
    "Port": 10002,
    "Protocol": "AsciiOverTcp",
    "CoilOffset": 2048,
    "RegisterOffset": 4096,
    //
    // 2) PlcSimulator (faux automate de ce dossier, sans ton Ladder) :
    //    "Ip": "127.0.0.1", "Port": 502, "Protocol": "Tcp", "CoilOffset": 0, "RegisterOffset": 0
    //
    // 3) Vrai automate Ethernet (ex. AS218PX) :
    //    "Ip": "192.168.0.1", "Port": 502, "Protocol": "Tcp", offsets à vérifier dans le manuel de la gamme
    //
    // Offsets : adresse Modbus de M0 (CoilOffset) et de D0 (RegisterOffset). Gamme DVP : M0 = 2048 (0x0800), D0 = 4096 (0x1000).
    // Identifiant d'esclave Modbus de l'automate.
    "UnitId": 1,
    // Relais M de marche machine (M20) : bouton Start / Stop général.
    "StartCoil": 20,
    // Consignes de vitesse écrites par le PC : D3000, D3001, D3002 (moteurs 1 à 3).
    "SetpointStart": 3000,
    // Vitesses mesurées lues par le PC : D3100, D3101, D3102 (moteurs 1 à 3).
    "FeedbackStart": 3100,
    // Période de lecture de l'état des moteurs (ms) sur l'écran principal.
    "PollMs": 100
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=scada;Username=postgres;Password=CHANGE_ME"
  }
}
